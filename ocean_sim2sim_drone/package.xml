<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ocean_sim2sim_drone</name>
  <version>0.1.0</version>
  <description>PX4 SITL drone for the ocean sim2sim scene: Gazebo lockstep plugin, PX4 bridge (Isaac Sim / Pegasus
    MAVLink HIL and thrust model), offboard commander, CLI.</description>
  <maintainer email="taeung1203ai@gmail.com">taeung</maintainer>
  <license>Apache-2.0</license>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_math_vendor</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- pymavlink: Python venv, see README (not a rosdep key) -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
