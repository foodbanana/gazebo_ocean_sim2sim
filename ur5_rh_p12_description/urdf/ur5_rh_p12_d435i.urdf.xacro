<?xml version="1.0"?>
<!--
  UR5 (CB3) + sandwich wrist mount + RH-P12-RN(A) gripper + RealSense D435i wrist camera.

  Chain:  robot_mount -> base_link ... wrist_3_link -> flange -> tool0
          tool0 -> wrist_mount (sandwich plate, thickness = mount_thickness)
          wrist_mount -> gripper_bracket -> rh_p12_rn_base (gripper)
          wrist_mount -> wrist_camera_mount -> D435i (wrist_camera_*)

  The root link is "robot_mount" and it is NOT welded to the world, so the arm can be
  attached to any parent (table, moving base, boat deck) with a fixed joint.

  Actuated joints (7): shoulder_pan_joint, shoulder_lift_joint, elbow_joint,
                       wrist_1_joint, wrist_2_joint, wrist_3_joint, rh_r1_joint
  Mimic joints (3):    rh_r2, rh_l1, rh_l2 follow rh_r1_joint (multiplier 1)

  Mesh paths use package:// URIs.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5_rh_p12_d435i">

  <!-- ================= arguments ================= -->
  <!-- UR kinematics. Pass a calibration file of your own robot for sim/real consistency,
       e.g. kinematics_params:=/path/to/my_robot_calibration.yaml -->
  <xacro:arg name="kinematics_params"
             default="$(find ur_description)/config/ur5/default_kinematics.yaml"/>

  <!-- Wrist camera mount variant. Selects the mount mesh, collision, mass/inertia AND the
       camera pose together (they must match):
         t10 (default): camera tab shifted -32.5 mm in x (RGB lens on the gripper centre line),
                        camera tilted 10 deg toward the tool axis
         t7, t0       : same mount with 7 / 0 deg tilt -->
  <xacro:arg name="mount_variant" default="t10"/>

  <xacro:arg name="mount_thickness" default="0.005"/>   <!-- plate: flange face -> gripper face [m] -->
  <xacro:arg name="mount_yaw" default="0.0"/>           <!-- mount(+camera+gripper) rotation about tool0 z -->
  <!-- RH-P12-RN-UR bracket (FRP42-A120K) between the mount and the gripper [m] / [kg] -->
  <xacro:arg name="adapter_thickness" default="0.010"/>
  <xacro:arg name="adapter_mass" default="0.08"/>
  <!-- gripper rotation about wrist_mount z. pi/2: fingers open along the camera's horizontal axis -->
  <xacro:arg name="gripper_yaw" default="1.5708"/>
  <!-- D435i orientation on the tab. default = camera top facing away from the tool axis.
       flipped (camera top toward the tool axis): cam_rpy:="1.5708 -1.5708 0" -->
  <xacro:arg name="cam_rpy" default="-1.5708 -1.5708 0.0"/>
  <!-- gripper joint effort limits [Nm] (URDF <limit effort>), 1000 = original ROBOTIS value.
       gripper_effort_limit       : rh_r1_joint (driven joint)
       gripper_mimic_effort_limit : rh_r2, rh_l1, rh_l2 (mimic joints)
       Isaac Sim keeps 1000 and limits its drive (maxForce 2.28 Nm). Gazebo (gz_ros2_control) uses the URDF limit as the
       joint force limit: the Gazebo launch lowers gripper_effort_limit (squeeze force) and keeps the mimic joints strong
       so they stay locked to rh_r1_joint (docs/grasp.md). -->
  <xacro:arg name="gripper_effort_limit" default="1000"/>
  <xacro:arg name="gripper_mimic_effort_limit" default="1000"/>
  <!-- collision meshes:
       original : the meshes as given (an importer that approximates them itself, e.g. Isaac Sim / PhysX)
       convex   : what Isaac Sim actually collides with: convex hull per link, forearm convex decomposition
                  (meshes/collision_convex, scripts/build_collision_hulls.py). Same shapes as Isaac Sim; Gazebo uses original
                  by default (DART + Bullet: one contact point per convex pair, docs/grasp.md 1-1). -->
  <xacro:arg name="collision_meshes" default="original"/>
  <xacro:property name="cm" value="$(arg collision_meshes)"/>
  <xacro:unless value="${cm in ('original', 'convex')}">${xacro.fatal('collision_meshes must be original or convex: ' + cm)}</xacro:unless>
  <xacro:property name="coll_dir" value="${pkg + '/meshes/collision_convex' if cm == 'convex' else pkg + '/meshes'}"/>

  <xacro:property name="pkg" value="package://ur5_rh_p12_description"/>
  <xacro:property name="t_mount" value="$(arg mount_thickness)"/>

  <!-- Per-variant values. COM [m] and per-kg inertia [kg m^2 / kg] about the COM in the
       wrist_mount frame, computed from the STL (uniform density). Mass: printed t10 weighed 32.36 g. -->
  <xacro:property name="MV" value="${dict(
      t0=dict(mesh='wrist_mount_t0.stl', mass=0.03236, tilt=0.0, cam_xyz='-0.0325 -0.0125 0.01015',
              com='-0.02677 0.02534 -0.00022', I=(7.2038e-04, 3.788e-04, -1.316e-05, 9.6429e-04, 1.199e-05, 1.6629e-03)),
      t7=dict(mesh='wrist_mount_t7.stl', mass=0.03236, tilt=radians(7), cam_xyz='-0.0325 -0.0125 0.01015',
              com='-0.02665 0.02504 -0.00029', I=(7.2460e-04, 3.821e-04, -1.388e-05, 9.6710e-04, 1.345e-05, 1.6702e-03)),
      t10=dict(mesh='wrist_mount_t10.stl', mass=0.03236, tilt=radians(10), cam_xyz='-0.0325 -0.0125 0.01015',
               com='-0.0266 0.0249 -0.00031', I=(7.2645e-04, 3.836e-04, -1.414e-05, 9.6841e-04, 1.395e-05, 1.6733e-03)))}"/>
  <xacro:property name="mv" value="$(arg mount_variant)"/>
  <xacro:unless value="${mv in MV}">${xacro.fatal('mount_variant must be one of ' + str(sorted(MV)) + ': ' + mv)}</xacro:unless>
  <xacro:property name="M" value="${MV[mv]}"/>
  <xacro:property name="m_mount" value="${M['mass']}"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>
  <xacro:include filename="$(find ur5_rh_p12_description)/urdf/rh_p12_rn_a.urdf.xacro"/>

  <!-- ================= root: mounting plate =================
       Attach this link to the parent (table / boat deck) with a fixed joint. -->
  <link name="robot_mount">
    <inertial>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1.7e-3" ixy="0" ixz="0" iyy="1.7e-3" iyz="0" izz="3.3e-3"/>
    </inertial>
  </link>

  <!-- ================= UR5 (CB3) ================= -->
  <xacro:ur_robot
    name="ur5"
    tf_prefix=""
    parent="robot_mount"
    joint_limits_parameters_file="$(find ur_description)/config/ur5/joint_limits.yaml"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(find ur_description)/config/ur5/physical_parameters.yaml"
    visual_parameters_file="${'$(find ur5_rh_p12_description)/config/ur5_visual_parameters_convex.yaml' if cm == 'convex' else '$(find ur_description)/config/ur5/visual_parameters.yaml'}">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ================= sandwich wrist mount ================= -->
  <!-- wrist_mount frame = tool0 frame (origin on the flange face, +z toward the gripper). Tab points to +y. -->
  <joint name="wrist_mount_joint" type="fixed">
    <parent link="tool0"/>
    <child link="wrist_mount"/>
    <origin xyz="0 0 0" rpy="0 0 $(arg mount_yaw)"/>
  </joint>

  <link name="wrist_mount">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${pkg}/meshes/mount/${M['mesh']}" scale="0.001 0.001 0.001"/></geometry>
      <material name="mount_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <!-- simple collision: a convex hull of the whole mesh would fill the flange pocket and overlap the wrist -->
    <!-- plate outline, z 0 ~ 5 mm (convex) -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${coll_dir}/mount/wrist_mount_collision_plate.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <!-- camera tab, full thickness (z -6.45 ~ 5 mm) -->
    <collision>
      <origin xyz="-0.0474 0.0569 -0.000725" rpy="0 0 0"/>
      <geometry><box size="0.0848 0.013 0.01145"/></geometry>
    </collision>
    <inertial>
      <origin xyz="${M['com']}" rpy="0 0 0"/>
      <mass value="${m_mount}"/>
      <inertia ixx="${m_mount*M['I'][0]}" ixy="${m_mount*M['I'][1]}" ixz="${m_mount*M['I'][2]}"
               iyy="${m_mount*M['I'][3]}" iyz="${m_mount*M['I'][4]}" izz="${m_mount*M['I'][5]}"/>
    </inertial>
  </link>

  <!-- ================= RH-P12-RN-UR bracket (simple shapes) ================= -->
  <xacro:property name="t_adp" value="$(arg adapter_thickness)"/>
  <xacro:property name="m_adp" value="$(arg adapter_mass)"/>
  <joint name="gripper_bracket_joint" type="fixed">
    <parent link="wrist_mount"/>
    <child link="gripper_bracket"/>
    <origin xyz="0 0 ${t_mount}" rpy="0 0 $(arg gripper_yaw)"/>
  </joint>
  <link name="gripper_bracket">
    <!-- round plate D63 x 4 mm on the mount, then a 42 x 42 square frame up to the gripper -->
    <visual>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0315" length="0.004"/></geometry>
      <material name="bracket_black"><color rgba="0.08 0.08 0.08 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 ${0.004 + (t_adp-0.004)/2}" rpy="0 0 0"/>
      <geometry><box size="0.042 0.042 ${t_adp-0.004}"/></geometry>
      <material name="bracket_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0315" length="0.004"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${0.004 + (t_adp-0.004)/2}" rpy="0 0 0"/>
      <geometry><box size="0.042 0.042 ${t_adp-0.004}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${t_adp/2}" rpy="0 0 0"/>
      <mass value="${m_adp}"/>
      <inertia ixx="${m_adp*(3*0.0315**2 + t_adp**2)/12}" ixy="0" ixz="0"
               iyy="${m_adp*(3*0.0315**2 + t_adp**2)/12}" iyz="0" izz="${m_adp*0.0315**2/2}"/>
    </inertial>
  </link>

  <!-- ================= gripper ================= -->
  <xacro:rh_p12_rn_a prefix="" parent="gripper_bracket" mesh_dir="${pkg}/meshes/rh_p12_rn_a" effort="$(arg gripper_effort_limit)" mimic_effort="$(arg gripper_mimic_effort_limit)" collision_dir="${coll_dir}/rh_p12_rn_a">
    <origin xyz="0 0 ${t_adp}" rpy="0 0 0"/>
  </xacro:rh_p12_rn_a>

  <!-- ================= wrist camera (D435i) =================
       wrist_camera_mount: centre of the two rear M3 holes on the tab face, tilted about x by the variant tilt.
       use_nominal_extrinsics=true creates the color/depth optical frames in the model. -->
  <joint name="wrist_camera_mount_joint" type="fixed">
    <parent link="wrist_mount"/>
    <child link="wrist_camera_mount"/>
    <origin xyz="0 0.0575 ${t_mount}" rpy="${M['tilt']} 0 0"/>
  </joint>
  <link name="wrist_camera_mount"/>

  <xacro:sensor_d435i parent="wrist_camera_mount" name="wrist_camera" use_nominal_extrinsics="true" add_plug="false" use_mesh="true">
    <origin xyz="${M['cam_xyz']}" rpy="$(arg cam_rpy)"/>
  </xacro:sensor_d435i>

</robot>
