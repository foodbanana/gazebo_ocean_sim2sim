<?xml version="1.0"?>
<!--
  Minimal WAM-V for ocean sim2sim: hull + VRX hydrodynamics + 2 aft thrusters ("H") + batteries + IMU.

  Everything is reused from VRX (wamv_description / wamv_gazebo) with $(find ...), nothing is copied.
  Left out on purpose (compared with the VRX competition WAM-V): CPU cases, cameras, LiDAR, GPS,
  ball shooter, pinger and the DetachableJoint that locks the boat to the dock posts.
  The deck top surface is free for a payload (e.g. a robot arm) at z = 1.30 m in ${namespace}/base_link.

  Requires (defined by the including file):
    - property "namespace" (scope global), e.g. "wamv"
    - arg "macros_file" (VRX wamv_gazebo macros)
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find wamv_gazebo)/urdf/wamv_gazebo.xacro"/>
  <xacro:include filename="$(find wamv_description)/urdf/battery.xacro"/>

  <!-- imu_*: IMU pose in ${namespace}/base_link. Default = centre of the deck plate underside
       (deck plate is 0.1 m thick, top at z = 1.30) -->
  <xacro:macro name="ocean_wamv" params="imu_x:=0.0 imu_y:=0.0 imu_z:=1.20">

    <!-- hull (wamv_base.urdf.xacro) + aft thrusters + Surface/SimpleHydrodynamics plugins -->
    <xacro:wamv_gazebo thruster_layout="$(find wamv_gazebo)/urdf/thruster_layouts/wamv_aft_thrusters.xacro"/>

    <!-- batteries in the hulls (23.5 kg each, keep the VRX mass distribution) -->
    <xacro:battery prefix="left" position="0 1 0.45" orientation="0 0 0"/>
    <xacro:battery prefix="right" position="0 -1 0.45" orientation="0 0 0"/>

    <xacro:wamv_imu name="imu_wamv" x="${imu_x}" y="${imu_y}" z="${imu_z}"/>

    <!-- pose and joint state topics (bridged by vrx_gz) -->
    <gazebo>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_sensor_pose>true</publish_sensor_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <publish_model_pose>false</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <static_update_frequency>1</static_update_frequency>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>
