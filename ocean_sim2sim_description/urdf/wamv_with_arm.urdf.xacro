<?xml version="1.0"?>
<!--
  WAM-V + a robot arm on the deck.

  The arm is pluggable. Any arm xacro works if it
    - is a complete robot description (a <robot> file) with xacro args that all have defaults, and
    - has ONE root link that is not welded to the world (arm_root_link).
  This file adds a single fixed joint: ${namespace}/base_link -> arm_root_link.

  Usage:
    xacro wamv_with_arm.urdf.xacro                       # UR5 + RH-P12-RN + D435i (default)
    xacro wamv_with_arm.urdf.xacro arm_xacro:=/path/to/other_arm.urdf.xacro arm_root_link:=base_link
  Arm xacro args can be passed on the same command line (xacro args are global),
    e.g. kinematics_params:=/path/to/my_robot_calibration.yaml
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="wamv_with_arm">

  <!-- ===== args given by vrx_gz (Model.xacro_cmd) when spawning. Only "namespace" is used ===== -->
  <xacro:arg name="namespace" default="wamv"/>
  <xacro:arg name="locked" default="false"/>               <!-- unused: no dock lock -->
  <xacro:arg name="vrx_sensors_enabled" default="false"/>  <!-- unused: no VRX sensor set -->
  <xacro:arg name="thruster_config" default="H"/>          <!-- unused: always H (2 aft thrusters) -->
  <xacro:property name="namespace" value="$(arg namespace)" scope="global"/>
  <xacro:arg name="macros_file" default="$(find wamv_gazebo)/urdf/macros.xacro"/>

  <!-- ===== Gazebo values of arm args (declared here first, so they win over the arm's own defaults) =====
       gripper_effort_limit 2.28 Nm = Isaac Sim gripper drive maxForce (real 400 mA); the mimic joints keep 1000 so they
       stay locked to rh_r1_joint (one driven joint + mimic, as in Isaac Sim). docs/grasp.md -->
  <xacro:arg name="gripper_effort_limit" default="2.28"/>
  <!-- collision shapes: original meshes. "convex" = the hulls Isaac Sim (PhysX) must use, but DART + Bullet gives one contact
       point per convex-convex pair (deep penetration, small objects wobble), docs/grasp.md 1-1 -->
  <xacro:arg name="collision_meshes" default="original"/>

  <!-- ===== arm ===== -->
  <xacro:arg name="arm_xacro" default="$(find ur5_rh_p12_description)/urdf/ur5_rh_p12_d435i.urdf.xacro"/>
  <xacro:arg name="arm_root_link" default="robot_mount"/>
  <!-- deck top centre (deck plate top at z = 1.30), arm facing the bow (+x) -->
  <xacro:arg name="arm_mount_xyz" default="0 0 1.30"/>
  <xacro:arg name="arm_mount_rpy" default="0 0 0"/>

  <!-- ===== boat ===== -->
  <xacro:include filename="$(find ocean_sim2sim_description)/urdf/wamv_base.xacro"/>
  <xacro:ocean_wamv/>

  <!-- ===== arm on the deck ===== -->
  <xacro:include filename="$(arg arm_xacro)"/>

  <joint name="arm_mount_joint" type="fixed">
    <parent link="${namespace}/base_link"/>
    <child link="$(arg arm_root_link)"/>
    <origin xyz="$(arg arm_mount_xyz)" rpy="$(arg arm_mount_rpy)"/>
  </joint>

  <!-- ===== arm control (ros2_control in Gazebo) =====
       arm_ros2_control_xacro: file that emits the arm's <ros2_control> tag (empty = no control)
       arm_controllers_yaml  : controller_manager parameters for that arm -->
  <xacro:arg name="arm_ros2_control_xacro"
             default="$(find ur5_rh_p12_description)/urdf/ur5_rh_p12.ros2_control.xacro"/>
  <xacro:arg name="arm_controllers_yaml"
             default="$(find ur5_rh_p12_description)/config/ros2_controllers.yaml"/>
  <xacro:if value="${'$(arg arm_ros2_control_xacro)' != ''}">
    <xacro:include filename="$(arg arm_ros2_control_xacro)"/>
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg arm_controllers_yaml)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- ===== arm sensors in Gazebo (cameras ...) =====
       arm_gazebo_xacro: file with the arm's <gazebo> sensor blocks (empty = none) -->
  <xacro:arg name="arm_gazebo_xacro"
             default="$(find ur5_rh_p12_description)/urdf/ur5_rh_p12.gazebo.xacro"/>
  <xacro:if value="${'$(arg arm_gazebo_xacro)' != ''}">
    <xacro:include filename="$(arg arm_gazebo_xacro)"/>
  </xacro:if>

  <!-- ===== collisions inside the model (arm <-> boat, arm <-> itself) =====
       Gazebo skips collisions between links of the same model unless self_collide is on.
       Links connected directly by a joint are still not checked against each other.
       Isaac Sim training also had self-collision enabled. -->
  <xacro:arg name="self_collide" default="true"/>
  <gazebo>
    <self_collide>$(arg self_collide)</self_collide>
  </gazebo>

</robot>
