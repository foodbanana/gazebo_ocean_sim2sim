<?xml version="1.0"?>
<!--
  Gazebo-only parts of the UR5 + RH-P12-RN arm: wrist D435i color camera, finger friction, contact monitor
  (per-link contact forces for the protective stop).

  Same as the Isaac Sim wrist camera (data_collection_ur5_gripper isaacsim/config/wrist_camera.yaml,
  real D435i camera_info 640x480, 2026-09-30):
    640 x 480 rgb8, 30 Hz, fx = fy = 618.5508 (Isaac Sim renders square pixels: fy = fx, real fy 618.956),
    cx 332.2763, cy 239.3807, no distortion, clip 0.01 ~ 10 m,
    topics /cam/wrist/color/image_raw and /cam/wrist/color/camera_info,
    frame_id wrist_camera_color_optical_frame.

  The sensor is attached to wrist_camera_color_frame (x forward, z up = Gazebo camera convention);
  wrist_camera_color_optical_frame (z forward) is the same point rotated, used as the image frame_id.
  horizontal_fov = 2 atan(320 / fx) = 0.9548 rad (the intrinsics below override the projection).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="wrist_camera_update_rate" default="30"/>

  <!-- Finger friction. Same INPUT as Isaac Sim (sim2sim: same values, the difference in the result is the gap):
       Isaac Sim finger / object material static 0.6, dynamic 0.5, combine min. DART has one coefficient per surface
       (the smaller of the two surfaces in contact is used, like "min") -> 0.6, the static value (it decides when a
       held object starts to slip). The objects use the same value (drone: ocean_sim2sim_gazebo/config/iris_drone.yaml).
       docs/grasp.md -->
  <xacro:arg name="gripper_friction" default="0.6"/>
  <xacro:macro name="ur5_rh_p12_finger_friction" params="link">
    <gazebo reference="${link}">
      <mu1>$(arg gripper_friction)</mu1>
      <mu2>$(arg gripper_friction)</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:ur5_rh_p12_finger_friction link="rh_p12_rn_r1"/>
  <xacro:ur5_rh_p12_finger_friction link="rh_p12_rn_r2"/>
  <xacro:ur5_rh_p12_finger_friction link="rh_p12_rn_l1"/>
  <xacro:ur5_rh_p12_finger_friction link="rh_p12_rn_l2"/>

  <gazebo reference="wrist_camera_color_frame">
    <sensor name="wrist_camera_color" type="camera">
      <always_on>true</always_on>
      <update_rate>$(arg wrist_camera_update_rate)</update_rate>
      <visualize>false</visualize>
      <topic>/cam/wrist/color/image_raw</topic>
      <gz_frame_id>wrist_camera_color_optical_frame</gz_frame_id>
      <camera name="wrist_camera_color">
        <camera_info_topic>/cam/wrist/color/camera_info</camera_info_topic>
        <horizontal_fov>0.9548</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>10.0</far>
        </clip>
        <lens>
          <!-- pinhole (the SDF default type is stereographic) -->
          <type>gnomonical</type>
          <scale_to_hfov>false</scale_to_hfov>
          <intrinsics>
            <fx>618.5508422851562</fx>
            <fy>618.5508422851562</fy>
            <cx>332.2762756347656</cx>
            <cy>239.38070678710938</cy>
            <s>0</s>
          </intrinsics>
        </lens>
      </camera>
    </sensor>
  </gazebo>

  <!-- Contact monitor (ocean_sim2sim_gz_plugins ContactMonitor, docs/interface.md "보호 정지"): per robot link the contact
       force magnitudes from the environment / the robot itself / the drone, every physics step on a gz topic (JSON),
       bridged to ROS for the protective stop of ocean_sim2sim_interface. Model-level plugin: it monitors the links of
       the model the arm is part of (here the boat) whose SDF names match robot_link_regex; every other link of that
       model (the boat, and the arm base / robot_mount, lumped into the boat link by URDF -> SDF) counts as environment.
       SDF link names of this arm after fixed-joint lumping: shoulder_link, upper_arm_link, forearm_link, wrist_1_link,
       wrist_2_link, wrist_3_link (+ wrist mount, gripper bracket, gripper base, wrist camera), rh_p12_rn_l1, _l2, _r1, _r2.
       contact_monitor_topic empty = no monitor. -->
  <xacro:arg name="contact_monitor_topic" default="/sim/robot_contacts"/>
  <xacro:arg name="contact_monitor_drone_regex" default="drone"/>
  <xacro:if value="${'$(arg contact_monitor_topic)' != ''}">
    <gazebo>
      <plugin filename="OceanSim2simContactMonitor" name="ocean_sim2sim::ContactMonitor">
        <robot_link_regex>shoulder_link|upper_arm_link|forearm_link|wrist_[123]_link|rh_p12_rn_[lr][12]</robot_link_regex>
        <drone_model_regex>$(arg contact_monitor_drone_regex)</drone_model_regex>
        <topic>$(arg contact_monitor_topic)</topic>
        <min_force>0.01</min_force>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
