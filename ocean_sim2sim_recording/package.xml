<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ocean_sim2sim_recording</name>
  <version>0.1.0</version>
  <description>Boat motion recordings for the ship motion predictor: one-command recording run (headless sim without
    the drone, boat ground truth every physics step, IMU, arm joints and commands in an mcap bag, run metadata),
    fixed / scripted capture-like arm motion, bag -> 100 Hz table on an exact sim time grid, E2 sign check.</description>
  <maintainer email="taeung1203ai@gmail.com">taeung</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ocean_sim2sim_interface</exec_depend>
  <exec_depend>ocean_sim2sim_bringup</exec_depend>
  <exec_depend>ocean_sim2sim_gz_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
